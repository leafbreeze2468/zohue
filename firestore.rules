rules_version = '2';

// 做伙飲的存取規則（見 docs/adr/0001-firebase-spark-only.md）
//   - 任何人拿到連結都能看揪團與點單
//   - 團長 = 用管理連結驗證過的裝置（groups/{id}/admins/{uid}）
//   - 管理金鑰放在 secrets/{id}，任何人都讀不到，只在規則裡比對
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function groupPath(id) { return /databases/$(database)/documents/groups/$(id); }
    function isAdmin(id) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(id)/admins/$(request.auth.uid));
    }
    // 與 src/domain.js 的 isLocked 相同
    function locked(g) {
      return g.manualLock == 'locked'
        || (g.manualLock != 'unlocked' && g.deadline != null && request.time.toMillis() >= g.deadline);
    }

    match /secrets/{id} {
      allow read: if false;
      // 只能在開團的同一批寫入中建立，且建立者必須是團長本人
      allow create: if signedIn()
        && getAfter(groupPath(id)).data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['adminKey']);
      allow update, delete: if false;
    }

    match /groups/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == id;
      allow update: if isAdmin(id)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'ownerUid', 'createdAt'])
        || (signedIn()
          && resource.data.phase == 'poll'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if false;

      match /admins/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['key'])
          && request.resource.data.key == getAfter(/databases/$(database)/documents/secrets/$(id)).data.adminKey;
        allow update, delete: if false;
      }

      // 點單內容的基本檢查（新增與修改共用）
      function validLine(d) {
        return d.participant is string && d.participant.size() > 0 && d.participant.size() <= 20
          && d.qty is int && d.qty >= 1 && d.qty <= 50;
      }

      match /lines/{lineId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.deviceId == request.auth.uid
          && validLine(request.resource.data)
          && get(groupPath(id)).data.phase == 'order'
          && !locked(get(groupPath(id)).data);
        allow delete: if isAdmin(id)
          || (signedIn() && resource.data.deviceId == request.auth.uid && !locked(get(groupPath(id)).data));
        // 修改：本人在截止前，或團長；不能改掉點單者與建立時間
        allow update: if (isAdmin(id)
            || (signedIn() && resource.data.deviceId == request.auth.uid && !locked(get(groupPath(id)).data)))
          && request.resource.data.deviceId == resource.data.deviceId
          && request.resource.data.createdAt == resource.data.createdAt
          && validLine(request.resource.data);
      }

      // 付款回報：每台裝置一筆（我是誰、帳號末五碼或付款方式），只有本人和團長看得到
      match /reports/{uid} {
        allow read: if isAdmin(id) || (signedIn() && request.auth.uid == uid);
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['participant', 'ref', 'at'])
          && request.resource.data.participant is string
          && request.resource.data.participant.size() > 0 && request.resource.data.participant.size() <= 20
          && request.resource.data.ref is string && request.resource.data.ref.size() <= 30;
        allow delete: if isAdmin(id) || (signedIn() && request.auth.uid == uid);
      }
    }
  }
}
